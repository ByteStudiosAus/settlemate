{
  "name": "agentrails",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server + permissions engine giving AI agents scoped, guardrailed access to the Pinch Payments API.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:perms": "tsx test/permissions.test.ts",
    "test:tools": "tsx test/tools.test.ts",
    "test:admin": "tsx test/admin.test.ts",
    "test:voice": "tsx test/voice.test.ts",
    "test:webhooks": "tsx test/webhooks.test.ts",
    "test:index": "tsx test/index.test.ts",
    "test": "tsx test/permissions.test.ts && tsx test/tools.test.ts && tsx test/admin.test.ts && tsx test/voice.test.ts && tsx test/webhooks.test.ts && tsx test/index.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "pinch:ping": "tsx scripts/pinch-ping.ts",
    "a2a": "tsx agents/a2a.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@cloudflare/workers-types": "^5.20260721.1",
    "chalk": "^5.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260721.1": true
  }
}
